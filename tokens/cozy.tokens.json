		"orange-text": { "light": "#6B2B11", "dark": "#FAD1BC", "group": "category", "role": "Category badge" },
		"yellow-bg": { "light": "#FAE1B5", "dark": "#443A26", "group": "category", "role": "Category badge" },
		"yellow-border": { "light": "#E5C27D", "dark": "#C99A44", "group": "category", "role": "Category badge" },
		"yellow-icon": { "light": "#8A5406", "dark": "#F5C96B", "group": "category", "role": "Category badge" },
		"yellow-text": { "light": "#5E3904", "dark": "#FCE09B", "group": "category", "role": "Category badge" },
		"blue-bg": { "light": "#D2D7DA", "dark": "#2B333D", "group": "category", "role": "Category badge" },
