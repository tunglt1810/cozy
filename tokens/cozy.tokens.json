	"font": {
		"family-sans": "\"Plus Jakarta Sans\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
		"family-mono": "ui-monospace, \"SF Mono\", Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace",
		"weight-regular": "400",
		"weight-medium": "500",
		"weight-semibold": "600",
		"weight-bold": "700"
	},
	"text": {
		"display": { "size": "2.1875rem", "leading": "1.2", "weight": "700" },
		"heading-1": { "size": "1.5rem", "leading": "1.3333", "weight": "600" },
		"heading-2": { "size": "1.25rem", "leading": "1.4", "weight": "600" },
		"heading-3": { "size": "1.0625rem", "leading": "1.4118", "weight": "700" },
		"heading-4": { "size": "0.875rem", "leading": "1.4286", "weight": "700" },
		"body": { "size": "0.875rem", "leading": "1.4286", "weight": "400" },
		"label": { "size": "0.875rem", "leading": "1.4286", "weight": "500" },
		"supporting": { "size": "0.75rem", "leading": "1.6667", "weight": "400" }
	},
	"space": {
		"0": "0",
		"1": "0.25rem",
		"2": "0.5rem",
		"3": "0.75rem",
		"4": "1rem",
		"5": "1.25rem",
		"6": "1.5rem",
		"8": "2rem",
		"10": "2.5rem",
		"12": "3rem"
	},
	"radius": {
		"inner": "0.5rem",
		"element": "0.75rem",
		"nav-item": "0.875rem",
		"container": "1.125rem",
		"card-expressive": "1.25rem",
		"nav": "1.375rem",
		"page": "1.75rem",
		"full": "9999px"
	},
	"shadow": {
		"low": "0 2px 6px light-dark(rgba(110, 74, 42, 0.06), rgba(0, 0, 0, 0.28)), 0 8px 20px -6px light-dark(rgba(110, 74, 42, 0.08), rgba(0, 0, 0, 0.42)), inset 0 0 0 1px light-dark(transparent, rgba(255, 240, 220, 0.06))",
		"med": "0 4px 10px light-dark(rgba(110, 74, 42, 0.08), rgba(0, 0, 0, 0.36)), 0 12px 28px -8px light-dark(rgba(110, 74, 42, 0.12), rgba(0, 0, 0, 0.52)), inset 0 0 0 1px light-dark(transparent, rgba(255, 240, 220, 0.09))",
		"high": "0 6px 14px light-dark(rgba(110, 74, 42, 0.11), rgba(0, 0, 0, 0.48)), 0 18px 36px -10px light-dark(rgba(110, 74, 42, 0.16), rgba(0, 0, 0, 0.68)), inset 0 0 0 1px light-dark(transparent, rgba(255, 240, 220, 0.12))",
		"toolbar": "0 -4px 12px -4px var(--cozy-shadow)",
		"focus": "0 0 0 2px var(--cozy-focus-offset-bg, var(--cozy-bg-surface)), 0 0 0 4px var(--cozy-focus-ring)"
	},
	"motion": {
		"ease-out": "cubic-bezier(0.22, 1, 0.36, 1)",
		"ease-standard": "cubic-bezier(0.4, 0, 0.2, 1)",
		"duration-fast": "160ms",
		"duration-page": "200ms",
		"duration-medium": "260ms",
		"duration-entrance": "340ms",
		"duration-slow": "480ms",
		"stagger-step": "28ms"
	},
	"spring": {
		"default": { "stiffness": 420, "damping": 32, "mass": 0.9 },
		"layout": { "stiffness": 400, "damping": 34, "mass": 0.9 },
		"count": { "stiffness": 120, "damping": 24, "mass": 0.8 }
	}
}
