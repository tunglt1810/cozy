{
	"name": "cozy",
	"version": "0.2.0",
	"color": {
		"bg-body": { "light": "#FAEBDA", "dark": "#18140E", "group": "surface", "role": "Page canvas" },
		"bg-surface": { "light": "#FBF1E1", "dark": "#231D16", "group": "surface", "role": "Cards, tables, panels, popovers" },
		"bg-muted": { "light": "#F3DFC8", "dark": "#30261D", "group": "surface", "role": "Segmented-control track, quiet emphasis" },
		"bg-inverted": { "light": "#3B2A1C", "dark": "#FFFEF7", "group": "surface", "role": "Active filter chip, inverted badge" },
		"text-on-inverted": { "light": "#FBF1E1", "dark": "#231D16", "group": "surface", "role": "Text on bg-inverted" },

		"text-primary": { "light": "#261101", "dark": "#FFFEF7", "group": "text", "role": "Body text, headings, primary icons" },
		"text-secondary": { "light": "#5B4C3B", "dark": "#C2B7B1", "group": "text", "role": "Supporting text, secondary icons" },
		"text-disabled": { "light": "#968574", "dark": "#70655C", "group": "text", "role": "Disabled text and icons" },
		"text-accent": { "light": "#A84A24", "dark": "#F2A57E", "group": "text", "role": "Links and accent text on body or surface" },
		"focus-ring": { "light": "#A84A24", "dark": "#F2A57E", "group": "accent", "role": "Keyboard focus outline" },

		"accent": { "light": "#EF8F63", "dark": "#EE8F64", "group": "accent", "role": "Primary action fill, active tab underline" },
		"on-accent": { "light": "#261101", "dark": "#18140E", "group": "accent", "role": "Text and icons on accent" },
		"accent-muted": { "light": "#EF8F6333", "dark": "#EE8F6438", "group": "accent", "role": "Selected-row tint, soft accent fill" },
		"accent-on-inverted": { "light": "#EE8F64", "dark": "#A84A24", "group": "accent", "role": "Accent icon on bg-inverted" },

		"success": { "light": "#2D7A4D", "dark": "#6FBF8E", "group": "status", "role": "Success fill, border, icon" },
		"on-success": { "light": "#FFFEF7", "dark": "#18140E", "group": "status", "role": "Text on success" },
		"success-muted": { "light": "#E2DEC4", "dark": "#31392C", "group": "status", "role": "Success banner background" },
		"on-success-muted": { "light": "#234930", "dark": "#C3E6CC", "group": "status", "role": "Text on success-muted" },
		"text-success": { "light": "#276B43", "dark": "#82CF9E", "group": "status", "role": "Success text on body or surface" },
		"success-on-inverted": { "light": "#6FBF8E", "dark": "#2D7A4D", "group": "status", "role": "Success icon on bg-inverted" },

		"warning": { "light": "#B87A12", "dark": "#F5C156", "group": "status", "role": "Warning fill, border, icon" },
		"on-warning": { "light": "#261101", "dark": "#18140E", "group": "status", "role": "Text on warning" },
		"warning-muted": { "light": "#FAE1B5", "dark": "#443A26", "group": "status", "role": "Warning banner background" },
		"on-warning-muted": { "light": "#6B4408", "dark": "#FCE09B", "group": "status", "role": "Text on warning-muted" },
		"text-warning": { "light": "#8A5406", "dark": "#F5C96B", "group": "status", "role": "Warning text on body or surface" },
		"warning-on-inverted": { "light": "#F5C156", "dark": "#B87A12", "group": "status", "role": "Warning icon on bg-inverted" },

		"error": { "light": "#C8433B", "dark": "#F27B70", "group": "status", "role": "Error fill, border, icon" },
		"on-error": { "light": "#FFFEF7", "dark": "#18140E", "group": "status", "role": "Text on error" },
		"error-muted": { "light": "#F9CFC8", "dark": "#472826", "group": "status", "role": "Error banner and destructive button background" },
		"on-error-muted": { "light": "#7E211C", "dark": "#F9BEB8", "group": "status", "role": "Text on error-muted" },
		"text-error": { "light": "#B0322B", "dark": "#F5938A", "group": "status", "role": "Error text on body or surface" },
		"error-on-inverted": { "light": "#F27B70", "dark": "#C8433B", "group": "status", "role": "Error icon on bg-inverted" },

		"info": { "light": "#3B6E9C", "dark": "#8BB8E0", "group": "status", "role": "Info fill, border, icon" },
		"on-info": { "light": "#FFFEF7", "dark": "#18140E", "group": "status", "role": "Text on info" },
		"info-muted": { "light": "#D2D7DA", "dark": "#2B333D", "group": "status", "role": "Info banner background" },
		"on-info-muted": { "light": "#234463", "dark": "#C5DEF5", "group": "status", "role": "Text on info-muted" },
		"text-info": { "light": "#2F5B84", "dark": "#9BC5EA", "group": "status", "role": "Info text on body or surface" },
		"info-on-inverted": { "light": "#8BB8E0", "dark": "#3B6E9C", "group": "status", "role": "Info icon on bg-inverted" },

		"border": { "light": "#5B4C3B22", "dark": "#3E3831", "group": "line", "role": "Default divider and outline" },
		"border-emphasized": { "light": "#DFCBB5", "dark": "#52493F", "group": "line", "role": "Input outline, emphasized divider" },
		"card-border": { "light": "#5B4C3B14", "dark": "#FFF0DC14", "group": "line", "role": "Subtle outline on elevated pastel cards" },
		"overlay": { "light": "#26110166", "dark": "#0D0A07B3", "group": "line", "role": "Modal scrim" },
		"overlay-hover": { "light": "#2611010D", "dark": "#FFFEF70F", "group": "line", "role": "Hover layer on any surface" },
		"overlay-pressed": { "light": "#2611011A", "dark": "#FFFEF71C", "group": "line", "role": "Pressed layer on any surface" },
		"shadow": { "light": "#6E4A2A1A", "dark": "#00000059", "group": "line", "role": "Shadow color for custom shadows" },
		"skeleton": { "light": "#EBD9C4", "dark": "#332B23", "group": "line", "role": "Loading placeholder" },
		"track": { "light": "#E6D2BC", "dark": "#30271E", "group": "line", "role": "Progress and slider track" },

		"nav-bg": { "light": "#C3CBB9", "dark": "#29332A", "group": "nav", "role": "Floating side navigation" },
		"nav-active": { "light": "#F8E8D3", "dark": "#404A41", "group": "nav", "role": "Active navigation pill" },
		"nav-text": { "light": "#403B26", "dark": "#FFFEF7", "group": "nav", "role": "Navigation label" },
		"nav-text-muted": { "light": "#55503A", "dark": "#B8C4B6", "group": "nav", "role": "Navigation group label and secondary icon" },

		"mark-peach": { "light": "#FAD3B9", "dark": "#7D4737", "group": "expressive", "role": "Highlighter stroke under a heading" },
		"mark-sage": { "light": "#E4DEC8", "dark": "#527366", "group": "expressive", "role": "Alternative highlighter stroke" },
		"pastel-sage": { "light": "#E2DEC4", "dark": "#31392C", "group": "expressive", "role": "Stat-card background" },
		"pastel-sage-icon": { "light": "#7EAB9A", "dark": "#5E8C7A", "group": "expressive", "role": "Stat-card icon chip" },
		"pastel-peach": { "light": "#FBCBB4", "dark": "#432F28", "group": "expressive", "role": "Stat-card background" },
		"pastel-peach-icon": { "light": "#F48A65", "dark": "#E5866B", "group": "expressive", "role": "Stat-card icon chip" },
		"pastel-butter": { "light": "#FAE1B5", "dark": "#443A26", "group": "expressive", "role": "Stat-card background" },
		"pastel-butter-icon": { "light": "#FAC76A", "dark": "#D9A74E", "group": "expressive", "role": "Stat-card icon chip" },
		"pastel-mist": { "light": "#D2D7DA", "dark": "#2B333D", "group": "expressive", "role": "Stat-card background" },
		"pastel-mist-icon": { "light": "#A2B3C1", "dark": "#6D8296", "group": "expressive", "role": "Stat-card icon chip" },
		"on-pastel": { "light": "#261101", "dark": "#18140E", "group": "expressive", "role": "Icon on a pastel icon chip" },

		"green-bg": { "light": "#E2DEC4", "dark": "#31392C", "group": "category", "role": "Category badge" },
		"green-border": { "light": "#B8C4A6", "dark": "#5E8C7A", "group": "category", "role": "Category badge" },
		"green-icon": { "light": "#3C6E58", "dark": "#8EC2AC", "group": "category", "role": "Category badge" },
		"green-text": { "light": "#234930", "dark": "#C3E6CC", "group": "category", "role": "Category badge" },
