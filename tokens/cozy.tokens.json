		"pink-icon": { "light": "#94304C", "dark": "#EDA0B3", "group": "category", "role": "Category badge" },
		"pink-text": { "light": "#6B1E34", "dark": "#FAD0DA", "group": "category", "role": "Category badge" },
		"red-bg": { "light": "#F9CFC8", "dark": "#472826", "group": "category", "role": "Category badge" },
		"red-border": { "light": "#E59F95", "dark": "#C25B53", "group": "category", "role": "Category badge" },
		"red-icon": { "light": "#B0322B", "dark": "#F5938A", "group": "category", "role": "Category badge" },
		"red-text": { "light": "#7E211C", "dark": "#F9BEB8", "group": "category", "role": "Category badge" },
